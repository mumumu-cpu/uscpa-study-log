    "db:migrate:local": "wrangler d1 migrations apply uscpa-study --local",
    "db:migrate:remote": "wrangler d1 migrations apply uscpa-study --remote",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.65.0",
    "next": "^15.5.28",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@cloudflare/workers-types": "^5.20261030.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vercel": "^47.0.4",
    "wrangler": "^4.156.0"
  }
